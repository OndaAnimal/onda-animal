# Neon -> Connection Details -> pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# PIN que será usado para entrar em /admin
ADMIN_PIN=troque-este-pin

# Gere uma chave longa e aleatória (mínimo recomendado: 32 bytes)
AUTH_SECRET=troque-por-uma-chave-longa-e-aleatoria

# URL pública do site após o deploy
NEXT_PUBLIC_SITE_URL=https://seu-projeto.vercel.app


# Cloudinary -> Dashboard / API Keys
# Estas 3 variáveis são usadas somente no servidor para uploads assinados.
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret


# OpenAI — Assistente IA de Adoção
# Chave somente do servidor. Nunca use NEXT_PUBLIC_ neste segredo.
OPENAI_API_KEY=sk-proj-...
# Opcional. Se vazio no código, usa gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna
